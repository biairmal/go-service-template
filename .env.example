# Copy to .env for local runs. Every key here is read by config/config.yaml.
SERVICE_NAME=note-service
SERVICE_VERSION=dev
APP_ENV=local

HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
LOG_FORMAT=json

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=app
# A secret outside local.
DB_PASSWORD=app
DB_SSLMODE=disable

# Token validation against identity's JWKS. Off locally: every route is public and every
# request runs as a fixed dev admin. Must be true in production (startup refuses otherwise).
AUTH_ENABLED=false
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json
AUTH_ISSUER=identity
AUTH_AUDIENCE=api

# Where permissions come from when auth is on: token | config | identity.
AUTHZ_SOURCE=identity
AUTHZ_IDENTITY_URL=http://localhost:8081

# This service's client credentials in identity's modules.auth.service_clients (identity stores
# an argon2id hash of the secret). Required when AUTH_ENABLED=true and AUTHZ_SOURCE=identity;
# the secret is a secret outside local. Generate one with: openssl rand -base64 32.
# The value below is the local dev secret whose argon2id hash deploy/compose/identity.yaml
# registers for `make up-identity`; never use it outside local.
IDENTITY_CLIENT_ID=note-service
IDENTITY_CLIENT_SECRET=local-note-service-secret

# Must match identity's modules.tenant.mode: single | multi.
TENANCY_MODE=single

TRACING_ENABLED=false
OTEL_ENDPOINT=localhost:4317

METRICS_ENABLED=true
METRICS_NAMESPACE=app

# API docs at /swagger/index.html, behind basic auth. Off by default; when enabled both
# SWAGGER_USERNAME and SWAGGER_PASSWORD are required, and the password is a secret outside local.
SWAGGER_ENABLED=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# Wait between readiness turning false and the HTTP drain: 0s locally, 5-10s in clusters.
DRAIN_DELAY=0s
