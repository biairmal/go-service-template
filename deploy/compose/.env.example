# VPS: copy to .env next to docker-compose.yaml. Compose reads it for the
# ${...} values in the Compose file and passes it to migrate, api and worker,
# which read the same keys as config/config.yaml (see the root .env.example).
# Local `make up` needs no .env: the config.yaml defaults apply (auth off).

# Image to run: a tag from GHCR (sha-<short>, main, or a release version).
IMAGE_TAG=main

# Public hostname; Caddy gets a TLS certificate for it.
DOMAIN=api.example.com

APP_ENV=production
SERVICE_NAME=note-service
CORS_ORIGINS=https://app.example.com
DRAIN_DELAY=5s

# Postgres superuser (container init and backups) and the app role. Both are secrets:
# generate with `openssl rand -base64 32`. Changing them after the first start
# needs ALTER ROLE; the init script only runs on an empty volume.
POSTGRES_PASSWORD=
DB_PASSWORD=

# Production requires auth. Identity is reached on its own host or Compose network.
AUTH_ENABLED=true
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_ISSUER=identity
AUTH_AUDIENCE=api
AUTHZ_SOURCE=identity
AUTHZ_IDENTITY_URL=https://identity.example.com
IDENTITY_CLIENT_ID=note-service
# A secret, required with AUTHZ_SOURCE=identity: this service's client secret in identity.
IDENTITY_CLIENT_SECRET=
TENANCY_MODE=single

# Days of daily pg_dump files kept in the `backups` volume.
BACKUP_KEEP_DAYS=7

# true when the obs profile runs (docker compose --profile obs up -d).
TRACING_ENABLED=false
