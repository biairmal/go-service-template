{$DOMAIN:localhost} {
	# /v1/internal is a service-to-service surface, not part of the public API.
	# Other services reach it directly on the Compose network (api:8080); the
	# public edge answers 404 instead of forwarding.
	route {
		@internal path /v1/internal*
		respond @internal 404
		reverse_proxy api:8080
	}
}
