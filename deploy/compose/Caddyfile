{$DOMAIN:localhost} {
	# /v1/internal and /metrics are service-to-service and scrape surfaces, not part of the public API.
	# Other services and Prometheus reach them directly on the Compose network (api:8080); the
	# public edge answers 404 instead of forwarding.
	route {
		@internal path /v1/internal* /metrics*
		respond @internal 404
		reverse_proxy {
			# Every api replica is its own upstream, looked up in Compose DNS each
			# second, so one replica going away never takes the others with it.
			dynamic a {
				name api
				port 8080
				refresh 1s
			}
			# No health_uri: Caddy runs active health checks on static upstreams
			# only. A stopping replica keeps serving through its drain delay, then
			# refuses connections, and the retry below moves the request on.
			# Mark a replica down for a while after a failed request.
			fail_duration 5s
			# A request that cannot reach a replica tries another one for up to 10s.
			lb_try_duration 10s
			lb_try_interval 250ms
			transport http {
				# A removed replica's address can stay in DNS for a second; fail fast.
				dial_timeout 1s
			}
		}
	}
}
